# =============================================================================
# ssh_config.example — шаблон ~/.ssh/config на Linux-агенте.
#
# Скопируй в ~/.ssh/config и поправь HostName/User:
#   cp ssh_config.example ~/.ssh/config  (или допиши блок в существующий)
#   chmod 600 ~/.ssh/config
#
# ControlMaster — не украшение, а требование схемы: sshd на Windows в режиме
# `-d` обслуживает ОДНО транспортное соединение (затем супервизор его
# перезапускает; см. windows/start_sshd.cmd). `ControlMaster auto` открывает
# одну транспортную сессию, и все последующие exec-/SFTP-вызовы мультиплексируются
# через нее в пределах ControlPersist — второй транспорт не нужен.
# =============================================================================

Host winbox
    # 100.x-адрес Windows-машины: вывод `tailscale status` на ней же
    # (или `headscale nodes list` на VPS).
    HostName 100.101.102.103
    # Порт sshd из windows/sshd_config.template ($SshPort в 1-install.ps1).
    Port 2222
    # Имя пользователя Windows, под которым работает канал.
    User winuser
    IdentityFile ~/.ssh/agent_ed25519
    IdentitiesOnly yes
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/cm-%r@%h:%p
    # Хост-ключ закрепляется при первом входе; последующие смены = тревога.
    StrictHostKeyChecking yes
